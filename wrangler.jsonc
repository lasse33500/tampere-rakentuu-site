{
  // Mansessa: historiasivusto (staattiset tiedostot) + Manse nyt (/nyt, Worker-koodi)
  "name": "mansessa",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "kv_namespaces": [{ "binding": "NYT" }],
  "triggers": { "crons": ["7,27,47 * * * *"] },
  "observability": { "enabled": true }
}
